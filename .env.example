# =============================================================================
# SkillForge AI — Root .env for Docker Compose
#
# Copy this file to .env and fill in real values.
# This .env file is read by docker-compose.yml at the project root.
# NEVER commit the actual .env file.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Application environment
APP_ENV=development

# PostgreSQL credentials (used by both the db service and backend DATABASE_URL)
POSTGRES_DB=skillforge
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=replace-with-secure-password

# JWT secret — REQUIRED (app refuses to start in production without it)
SECRET_KEY=replace-with-a-long-random-secret

# Allowed CORS origins for the backend (comma-separated)
# Local Docker: http://localhost is sufficient (browser connects on port 80)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL (baked into Vite bundle at build time — browser-accessible)
# Must point to where the BROWSER can reach the backend.
# Local Docker Compose: http://localhost:8000 (backend published on host port 8000)
VITE_API_BASE_URL=http://localhost:8000
