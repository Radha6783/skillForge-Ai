# =============================================================================
# SkillForge AI — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# Generate a secure SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# Application Environment
# Set to "production" to enforce secrets and disable Swagger UI
APP_ENV=development
PORT=8000

# CORS — allowed frontend origins (comma-separated, no trailing slash)
# Docker Compose local: http://localhost
# Production: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# Database — PostgreSQL connection string
# Docker Compose: use "db" as the host (Docker service name)
# Local development: use "localhost"
DATABASE_URL=postgresql+psycopg2://skillforge:replace-with-secure-password@db:5432/skillforge

# PostgreSQL service credentials (used by the db container in Docker Compose)
POSTGRES_DB=skillforge
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=replace-with-secure-password

# JWT Security — REQUIRED in production (app will refuse to start without it)
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider
AI_PROVIDER=google_gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL (baked into the Vite build — see frontend/.env.example)
# Docker Compose local: http://localhost:8000
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8000
