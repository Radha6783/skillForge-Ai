# Frontend Environment Variables
# ============================================================
# IMPORTANT: VITE_* variables are BAKED INTO the JavaScript
# bundle at build time. They are publicly readable by anyone
# who downloads the frontend.
#
# NEVER put backend secrets, API keys, database credentials,
# or JWT secrets in VITE_* variables.
# ============================================================

# The URL of the SkillForge AI backend API.
# For local Docker Compose: http://localhost:8000
# For production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8000
